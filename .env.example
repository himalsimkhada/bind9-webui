# BIND9 Web UI — docker-compose.yml (web-UI only) configuration.
# Copy this file to `.env` and edit the values, then run: docker compose up -d --build

# IP or hostname of the existing BIND9 server this web UI will manage.
# NOTE: 127.0.0.1 inside the container refers to the container itself, NOT the host.
# To reach BIND running on the Docker host, use the Docker gateway IP. It is usually
# .1 on the compose network; discover it with:
#   docker inspect bind9-webui --format '{{range .NetworkSettings.Networks}}{{.Gateway}}{{end}}'
# (Common values: 172.18.0.1, 172.17.0.1, or host.docker.internal if supported.)
RNDC_HOST=172.18.0.1

# rndc control channel port on the target BIND (must match its controls block).
RNDC_PORT=953

# Host BIND must listen on TCP 953 for the container to reach it. Add to the host's
# /etc/bind/named.conf (replace <key-name> with the rndc key name, e.g. rndc-key):
#
#   controls { inet 0.0.0.0 port 953 allow { any; } keys { "rndc-key"; }; };
#
# then restart named, e.g.  sudo systemctl restart named

# Host TCP port the web UI is exposed on.
WEBUI_PORT=5000

# Optional absolute path (as seen inside the container) of a BIND log file to
# tail for the Logs tab. Leave empty to auto-detect / show no logs.
# LOG_FILE=/var/log/bind/named.log
